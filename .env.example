PORT=4000
NODE_ENV=development

# MongoDB connection string
# For local Mongo: mongodb://localhost:27017/seu
# For Atlas:       mongodb+srv://<user>:<pass>@<cluster>/seu?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:zangidzagli@seu.p66osk1.mongodb.net

# CORS origin for the Next.js frontend (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000

# API global prefix
API_PREFIX=api

# ── Contact-request notifications ───────────────────────────────────────────
# Every contact form submission is emailed to CONTACT_NOTIFY_TO. Leave
# SMTP_HOST empty to disable mail entirely — requests are still stored and
# shown in the admin panel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail: an App Password, not the account password
SMTP_PASS=
# A display name is enough — it is paired with SMTP_USER as the sender.
# A full address or `Name <addr@host>` is used as written.
MAIL_FROM="SEU Development"
# Where notifications go — comma-separated for several recipients.
# The older CONTACT_NOTIFICATION_TO / MAIL_TO names are still read as fallbacks,
# and SMTP_PASSWORD still works in place of SMTP_PASS, so an existing server
# .env keeps working after the rename.
CONTACT_NOTIFY_TO=

# Optional — used to link the apartment and the admin panel from the mail
PUBLIC_SITE_URL=http://localhost:3000
# Optional — defaults to PUBLIC_SITE_URL + /en/admin/contacts
ADMIN_CONTACTS_URL=
# Optional — timestamps in the mail, defaults to Asia/Tbilisi
MAIL_TIMEZONE=Asia/Tbilisi
# Optional — true for implicit TLS; port 465 turns this on by itself
SMTP_SECURE=false
