PORT=4000
NODE_ENV=development

# MongoDB connection string
# For local Mongo: mongodb://localhost:27017/seu
# For Atlas:       mongodb+srv://<user>:<pass>@<cluster>/seu?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:zangidzagli@seu.p66osk1.mongodb.net

# CORS origin for the Next.js frontend (comma-separated for multiple)
CORS_ORIGIN=http://localhost:3000

# API global prefix
API_PREFIX=api

# ── Contact-request notifications ───────────────────────────────────────────
# Every contact form submission is emailed to CONTACT_NOTIFICATION_TO (or
# MAIL_TO when that is unset). Leave SMTP_HOST empty to disable mail entirely —
# requests are still stored and shown in the admin panel.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false for STARTTLS (587/25)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Envelope sender, e.g. "SEU Development <no-reply@seudevelopment.ge>"
MAIL_FROM=
# Where notifications go — comma-separated for several recipients
CONTACT_NOTIFICATION_TO=
# Fallback recipient for any other mail the backend sends
MAIL_TO=
# Timestamps in the mail are printed in this zone
MAIL_TIMEZONE=Asia/Tbilisi

# Used to link the apartment and the admin panel from inside the mail
PUBLIC_SITE_URL=http://localhost:3000
# Optional override; defaults to PUBLIC_SITE_URL + /en/admin/contacts
ADMIN_CONTACTS_URL=
